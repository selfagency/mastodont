{
  "name": "mastodont",
  "version": "0.1.12",
  "description": "CLI tool to import server blocklists into Mastodon v4+",
  "keywords": [
    "mastodon",
    "fediverse",
    "moderation",
    "blocklist",
    "filter"
  ],
  "homepage": "https://github.com/selfagency/mastodont#readme",
  "bugs": {
    "url": "https://github.com/selfagency/mastodont/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfagency/mastodont.git"
  },
  "license": "MIT",
  "author": "Daniel Sieradski <daniel@self.agency>",
  "type": "module",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "postbuild": "node ./scripts/write-dist-package.js",
    "dev": "DEBUG=* npx tsx --watch src/index.ts",
    "format": "oxfmt --write",
    "postinstall": "if $(git rev-parse --is-inside-work-tree); then husky install; fi",
    "lint": "oxlint",
    "lint-staged": "lint-staged --allow-empty",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "tsc:check": "tsc --noEmit"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "pnpm tsc:check",
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "devDependencies": {
    "@thi.ng/args": "^2.2.8",
    "@types/node": "25.3.0",
    "@types/prompts": "^2.4.9",
    "consola": "3.4.2",
    "husky": "9.1.7",
    "is-url-superb": "^6.1.0",
    "lint-staged": "16.2.7",
    "node-fetch": "^3.3.2",
    "open": "11.0.0",
    "ora": "9.3.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.14.2",
    "prettier": "3.8.1",
    "prompts": "^2.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
